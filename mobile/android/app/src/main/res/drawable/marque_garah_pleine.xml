<?xml version="1.0" encoding="utf-8"?>
<!--
  LA CALEBASSE, cadree pour une ICONE ADAPTATIVE.

  ⚠️ Ce n est pas un doublon de marque_garah.xml, et la difference n est pas
     cosmetique : une icone adaptative est dessinee sur 108 dp, dont seuls les
     66 dp CENTRAUX sont surs. Le lanceur rogne le reste — en cercle, en carre
     arrondi, en goutte, selon le telephone.

     Le trace est donc pose dans un repere de 108 unites, centre, a l echelle
     qui le fait tenir dans la zone sure. Reutiliser le fichier de 48 unites
     aurait fait toucher les bords a l anse, et un lanceur en cercle l aurait
     coupee.

  ⚠️ La couleur est ecrite en dur : Android lit ce fichier avant que Dart n
     existe. Elle doit rester egale a `constantes.marque` de
     charte/jetons.json.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Le groupe deplace et reduit le trace d origine (repere 48) dans la
         zone sure : facteur 0,62 puis recentrage. -->
    <group
        android:translateX="39.12"
        android:translateY="39.12"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <path
            android:pathData="M10,25A15,15 0 0 1 37.29,16.4"
            android:strokeColor="#12A594"
            android:strokeWidth="5"
            android:strokeLineCap="butt" />

        <path
            android:pathData="M10,25A15,15 0 0 0 40,25Z"
            android:fillColor="#12A594" />
    </group>
</vector>
